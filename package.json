{
  "name": "strata-pc-simulator",
  "version": "1.0.0",
  "description": "A realistic PC-building simulator for MoE local inference (Strata engine). Drag parts into a case, boot it up, and watch decode/prefill/TTFT/expert-residency/thermals respond to your hardware and Strata settings.",
  "main": "src/parts.js",
  "scripts": {
    "test": "node test.js",
    "i18n": "node scripts/i18ncheck.js",
    "check": "node test.js && node scripts/i18ncheck.js",
    "build": "node scripts/build.js",
    "serve": "node scripts/serve.js",
    "audit": "node scripts/audit3d.js"
  },
  "keywords": [
    "strata",
    "moe",
    "llm",
    "local-llm",
    "pc-builder",
    "hardware-simulator",
    "qwen",
    "expert-cache",
    "pcie",
    "visualization"
  ],
  "author": "Mingming",
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
